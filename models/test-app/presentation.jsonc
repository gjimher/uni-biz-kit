{
  "$schema": "../../schemas/presentation_schema.json",
  // Design mode also ships in production builds: authenticated users keep a
  // personal design in the generated _design table; admins review them all.
  "designer": "production",
  "designer_admin_role": "admin",
  "menu": [
    {
      "label": "Catalog",
      "children": [
        { "label": "Products", "concept": "product" },
        { "label": "Categories", "concept": "category" }
      ]
    },
    {
      "label": "Sales",
      "children": [
        { "label": "Orders", "concept": "order" },
        { "label": "Customers", "concept": "customer" },
        // view concept: read-only list, rows open the customer
        { "label": "Customer totals", "concept": "customer_totals" }
      ]
    },
    {
      "label": "Test",
      "children": [
        { "label": "Field checkers", "concept": "field_checker" },
        { "label": "External company", "concept": "external_company" }
      ]
    },
    {
      "label": "Tasks",
      "children": [
        { "label": "Assignable tasks", "workflow": "assignable_tasks" },
        { "label": "My tasks", "workflow": "my_tasks" }
      ]
    },
    {
      // Model documentation generated from the enriched model: it also covers
      // the concepts and permissions the generator injects
      "label": "Documentation",
      "children": [
        { "label": "Roles", "docs": "roles" },
        { "label": "Concepts", "docs": "concepts" },
        { "label": "Workflows", "docs": "workflows" },
        { "label": "Security", "docs": "security" }
      ]
    }
  ],
  "list_field_rules_level_2": {
    // product: remove fields after price, add sku to the end and remove details field
    //  same as: "!*,name,description,details,price,sku"
    "product": "!>price, sku, !details",
    // category: hide slug (URL-only field, not useful in admin lists)
    "category": "!slug",
    // order: show id as first column and remove fields after total_amount
    "order": "id_presentation[0], !>total_amount",
    // customer: remove fields after email
    "customer": "!>email",
    // customer_totals (view): the id label and the polymorphic concept column
    // are plumbing here, the view only ever aggregates customers
    "customer_totals": "!*, customer, order_count, ordered_amount"
  },
  "list_sort": {
    // Newest orders first
    "order": "order_date DESC"
  }
}
