// Demo dataset: three projects in different shapes (a scrum platform project mid-sprint,
// a continuous-flow marketing site and a young mobile project), so the boards, the backlog
// and the reports all have something to show right after a reset.
//
// Seed ids are model-local aliases used to wire the records together; the database
// assigns the real numeric ids. Members come first because everything references them,
// and inside the issue array parents/epics precede the issues that point at them
// (self-references are not reordered by the topological sort).
{
  "$schema": "../../schemas/seed_data_schema.json",
  // Real, coherent demo data only — no faker rows on top of it.
  "include_test_data": false,
  "records": {
    // _user_pending_link claims the seeded profile for that seed user the first time
    // they sign in, so pm@agile.com *is* Paula rather than an empty auto-created profile.
    "member": [
      { "id": "paula", "first_name": "Paula", "last_name": "Rivas", "job_title": "Project Manager", "capacity_hours_per_sprint": 30, "is_active": true, "_user_pending_link": "pm@agile.com" },
      { "id": "diego", "first_name": "Diego", "last_name": "Ferrer", "job_title": "Senior Backend Developer", "capacity_hours_per_sprint": 60, "is_active": true, "_user_pending_link": "dev1@agile.com" },
