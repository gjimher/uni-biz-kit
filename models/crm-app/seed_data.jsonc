        "resolution": "The renewal was activated twice in the billing system. The duplicate was credited and the automatic renewal job now checks for an existing invoice." },
      { "id": "case-cas-mobile", "account": "cascade", "contact": "c-amelie", "subject": "Clienteling app crashes on the older store tablets", "state": "closed", "type": "incident", "reason": "design_defect", "origin": "phone", "priority": "high", "owner": "ravi", "asset": "as-cas-pro", "entitlement": "ent-cascade", "resolution_code": "workaround", "opened_date": "2026-06-18", "closed_date": "2026-06-27",
        "description": "The app closes when opening a customer card on the tablets from 2019.",
        "resolution": "Caused by the image cache size on devices with 2 GB of RAM. Workaround: disable the high-resolution product images on those devices. A fix ships in 4.3." }
    ],
    "case_comment": [
      { "support_case": "case-nw-sync", "author": "ravi", "is_public": true, "body": "Confirmed on our side: the scanner API rejects the new authentication header. We are preparing a hotfix and will keep you posted every hour." },
      { "support_case": "case-nw-sync", "author": "laura", "is_public": false, "body": "Escalated to engineering. This account is in the middle of the Enterprise upgrade negotiation — treat it as the top priority of the week." },
      { "support_case": "case-nw-report", "author": "ravi", "is_public": true, "body": "We can reproduce it with more than 500 opportunities in the region. Investigating the report cache invalidation." },
      { "support_case": "case-cas-import", "author": "ravi", "is_public": true, "body": "Re-export the file as UTF-8 and the import goes through. We are adding latin-1 detection so the extra step is not needed." },
      { "support_case": "case-cas-erp", "author": "ravi", "is_public": false, "body": "The batch is pulling 50,000 orders in one go. Proposing to page it in blocks of 5,000 and to move the run to 02:00." },
      { "support_case": "case-cas-erp", "author": "ravi", "is_public": true, "body": "Tonight's run is limited to 5,000 orders per block. Please confirm tomorrow whether the synchronisation completed." },
      { "support_case": "case-nw-invoice", "author": "ravi", "is_public": true, "body": "Credit note issued and the duplicate cancelled. Sorry for the noise." },
      { "support_case": "case-cas-mobile", "author": "ravi", "is_public": true, "body": "The high-resolution images are now disabled for the 2019 tablets. The permanent fix ships with release 4.3 in September." }
    ],
