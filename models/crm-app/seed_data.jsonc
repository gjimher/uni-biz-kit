    "note": [
      { "title": "Northwind: board meeting on Thursday", "author": "carlos", "is_private": false, "account": "northwind", "opportunity": "opp-northwind-ent",
        "body": "Elena presents the upgrade to the board on Thursday. She asked for a one-page summary with the cost per depot and the adoption figures of the current deployment. Anna is preparing it." },
      { "title": "Brightbank security review — what is left", "author": "anna", "is_private": false, "account": "brightbank", "opportunity": "opp-brightbank",
        "body": "Twelve questions still open, all about data residency and key management. Priya wants the pen-test report of the last release, not the summary. Oliver will push internally once the answers are in." },
      { "title": "Helios: procurement plays hardball on the liability cap", "author": "mei", "is_private": true, "account": "helios", "opportunity": "opp-helios-group",
        "body": "Marta has rejected the standard cap twice. Legal is fine going to 12 months of fees. Do not offer it before the committee meeting: Jordi thinks he can close it without touching the cap." },
      { "title": "Cascade: the 2019 tablets are the real blocker", "author": "ravi", "is_private": false, "account": "cascade", "support_case": "case-cas-mobile",
        "body": "Around 60 tablets in the older stores have 2 GB of RAM. The image cache fix ships in 4.3, but the rollout to the remaining stores should assume the workaround until then." },
      { "title": "Atlas: revisit at the incumbent renewal", "author": "mei", "is_private": false, "account": "atlas", "opportunity": "opp-atlas",
        "body": "Jenna will not take calls before the end of the year (do_not_call is set on purpose). Their Dynamix contract renews in early 2027; the plan is to reach out in November through the partner." }
    ],
