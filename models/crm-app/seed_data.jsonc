    "knowledge_article": [
      { "id": "ka-forecast", "title": "Forecast categories explained", "category": "kc-start", "status": "published", "language": "en", "is_public": true, "author": "anna", "published_on": "2026-02-18", "keywords": "forecast, commit, best case, pipeline", "view_count": 412, "helpful_count": 118,
        "summary": "What each forecast category means and how the stage of a deal decides it.",
        "body": "# Forecast categories\n\nThe category is derived from the stage, never typed by hand:\n\n| Stage | Category |\n|---|---|\n| Prospecting, Qualification | Pipeline |\n| Needs analysis, Proposal | Best case |\n| Negotiation | Commit |\n| Closed won | Closed |\n| Closed lost | Omitted |\n\nMove the deal and the forecast follows. There is nothing else to update." },
      { "id": "ka-import", "title": "Importing users from a CSV exported as latin-1", "category": "kc-admin", "status": "published", "language": "en", "is_public": true, "author": "ravi", "published_on": "2026-07-21", "keywords": "import, csv, encoding, accents, latin-1", "view_count": 96, "helpful_count": 41,
        "summary": "Accented names are rejected when the file is not UTF-8. Re-export it or convert it in one command.",
        "body": "## Symptom\n\nThe import stops on rows with accented characters (`Núñez`, `Ferrán`).\n\n## Cause\n\nThe file was exported as latin-1 by the HR system.\n\n## Fix\n\nRe-export as UTF-8, or convert it:\n\n```bash\niconv -f latin1 -t utf-8 users.csv > users-utf8.csv\n```\n\nRelease 4.3 detects latin-1 automatically." },
      { "id": "ka-erp-batch", "title": "Tuning the ERP connector batch size", "category": "kc-int", "status": "published", "language": "en", "is_public": false, "author": "ravi", "published_on": "2026-07-22", "keywords": "erp, connector, timeout, batch, nightly", "view_count": 63, "helpful_count": 28,
        "summary": "A nightly run that times out is almost always pulling too many records in one page.",
        "body": "The connector pages the source in blocks. Above ~20,000 records per block the run does not finish inside the 30-minute window.\n\n**Recommended settings**\n\n* Block size: 5,000 records\n* Window: 02:00–04:00 local time\n* Retries: 3, with exponential backoff\n\nAfter changing the block size, watch two consecutive nights before closing the case." },
      { "id": "ka-scanner", "title": "Depot scanners stop syncing after release 4.2", "category": "kc-trouble", "status": "in_review", "language": "en", "is_public": false, "author": "ravi", "keywords": "scanner, sync, 4.2, authentication header", "view_count": 22, "helpful_count": 5,
        "summary": "Known issue: the scanner API rejects the new authentication header. A hotfix is on its way.",
        "body": "Handheld scanners running firmware below 3.4 reject the authentication header introduced in 4.2.\n\n**Workaround**: keep the depot on the previous client until the hotfix ships.\n\n**Status**: hotfix in engineering, tracked from the Northwind incident." },
      { "id": "ka-queue-access", "title": "Granting service desk agents access to the case queue", "category": "kc-admin", "status": "published", "language": "en", "is_public": true, "author": "ravi", "published_on": "2026-05-30", "keywords": "permissions, queue, agents, visibility", "view_count": 145, "helpful_count": 62,
        "summary": "New agents only see their own cases until they are added to the support role.",
        "body": "A new agent sees only the cases assigned to them. To let them work the whole queue:\n\n1. Add the user to the **support** role.\n2. Check the account team of the customer, if the queue is scoped by account.\n3. Ask the agent to sign out and back in so the new permissions are loaded." },
      { "id": "ka-admin-first", "title": "First steps as a CRM administrator", "category": "kc-start", "status": "published", "language": "en", "is_public": true, "author": "anna", "published_on": "2026-01-20", "keywords": "administrator, setup, first steps", "view_count": 388, "helpful_count": 151,
        "summary": "The five things to set up before letting the sales team in.",
        "body": "1. **People**: create the users and put them in the right role.\n2. **Territories**: build the tree and assign the accounts.\n3. **Price books**: load the catalogue and the partner list.\n4. **Quotas**: set the period quotas so the forecast means something.\n5. **Business hours**: define the calendar the service commitments are measured against." },
      { "id": "ka-migration", "title": "Migrating from a legacy CRM without losing history", "category": "kc-admin", "status": "draft", "language": "en", "is_public": false, "author": "anna", "keywords": "migration, legacy, history, mapping",
        "summary": "Draft: the mapping approach we use on migration projects.",
        "body": "Work in progress. Covers the field mapping sheet, the two-pass load (accounts and contacts first, then the pipeline) and how to keep the closed deals of the last three years for the forecast history." },
      { "id": "ka-clienteling-es", "title": "Clienteling en tienda: guía rápida para el personal", "category": "kc-start", "status": "published", "language": "es", "is_public": true, "author": "anna", "published_on": "2026-06-25", "keywords": "clienteling, tienda, tablet, ficha de cliente", "view_count": 210, "helpful_count": 87,
        "summary": "Cómo consultar la ficha de un cliente y registrar una visita desde la tablet de la tienda.",
        "body": "## En la tienda\n\n1. Busca al cliente por email o teléfono.\n2. Abre su ficha: verás sus últimas compras y sus preferencias.\n3. Registra la visita como una actividad antes de cerrar la ficha.\n\n**Nota**: en las tablets de 2019 conviene desactivar las imágenes de alta resolución." }
    ],
    "case_milestone": [
      { "support_case": "case-nw-sync", "name": "Critical first response", "target_hours": 1, "started_at": "2026-07-24T08:05:00", "target_at": "2026-07-24T09:05:00", "completed_at": "2026-07-24T08:41:00", "notes": "Answered by the duty engineer inside the hour" },
