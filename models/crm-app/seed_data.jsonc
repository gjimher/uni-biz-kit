    "email_message": [
      { "support_case": "case-nw-sync", "direction": "inbound", "from_address": "pablo.herrera@northwind-logistics.example", "to_address": "support@crm.com", "subject": "URGENT: scanners offline in twelve depots", "sent_at": "2026-07-24T08:02:00", "has_attachment": true,
        "body": "Since the 4.2 release went out last night the handhelds cannot push deliveries. Twelve depots are writing on paper. Screenshots of the error attached." },
      { "support_case": "case-nw-sync", "direction": "outbound", "from_address": "support@crm.com", "to_address": "pablo.herrera@northwind-logistics.example", "subject": "Re: URGENT: scanners offline in twelve depots", "sent_at": "2026-07-24T08:41:00",
        "body": "Confirmed on our side: the scanner API is rejecting the new authentication header. Engineering is preparing a hotfix and I will write to you every hour until it is out." },
      { "support_case": "case-nw-report", "direction": "inbound", "from_address": "elena.barros@northwind-logistics.example", "to_address": "support@crm.com", "subject": "Regional pipeline numbers are a week old", "sent_at": "2026-07-22T10:18:00",
        "body": "The regional report still shows last Monday's figures. Refreshing does not change anything. I need it right for Thursday's board meeting." },
      { "support_case": "case-cas-import", "direction": "inbound", "from_address": "thomas.lambert@cascade-retail.example", "to_address": "support@crm.com", "subject": "Store associate import fails", "sent_at": "2026-07-20T08:55:00", "has_attachment": true,
        "body": "The import rejects every row with an accent. The file comes straight out of our HR system." },
      { "support_case": "case-cas-import", "direction": "outbound", "from_address": "support@crm.com", "to_address": "thomas.lambert@cascade-retail.example", "subject": "Re: Store associate import fails", "sent_at": "2026-07-20T16:30:00",
        "body": "Your file is encoded as latin-1. Re-export it as UTF-8 (or run iconv on it) and the import goes through — see the attached article. We are adding automatic detection in 4.3." },
      { "support_case": "case-cas-erp", "direction": "inbound", "from_address": "thomas.lambert@cascade-retail.example", "to_address": "support@crm.com", "subject": "Nightly ERP sync timed out again", "sent_at": "2026-07-19T07:35:00",
        "body": "Third night in a row. Orders are half imported and the store team finds duplicates in the morning." },
      { "support_case": "case-hi-training", "direction": "inbound", "from_address": "marc.ferran@iberia.helios-energy.example", "to_address": "support@crm.com", "subject": "Dates for the administrator training", "sent_at": "2026-07-25T11:58:00",
        "body": "We agreed two sessions with the group. Which dates do you have in September? We are twelve people." },
      { "support_case": "case-nw-invoice", "direction": "outbound", "from_address": "support@crm.com", "to_address": "elena.barros@northwind-logistics.example", "subject": "Re: Duplicate invoice for the March renewal", "sent_at": "2026-07-03T08:40:00",
        "body": "The renewal was activated twice in the billing system. The duplicate has been credited and the job now checks for an existing invoice before issuing one. Sorry for the noise." }
    ],
